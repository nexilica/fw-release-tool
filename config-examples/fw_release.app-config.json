{
  "paths": {
    "header": "../Application/version.h",
    "srec": ""
  },
  "version": {
    "defines": {
      "major": "APP_FW_VERSION_MAJOR",
      "minor": "APP_FW_VERSION_MINOR",
      "build": "APP_FW_VERSION_PATCH"
    }
  },
  "behavior": {
    "insert_s0": true,
    "s0_prefix": "APP",
    "rename_mode": "copy",
    "quiet": false
  },
  "outputs": {
    "write_log": true,
    "log_path": "../Release/build_info.log",
    "write_version_file": false,
    "version_file_path": "../Release/fw_version.txt",
    "write_tool_version_file": false,
    "tool_version_file_path": ""
  },
  "git": {
    "tag": false,
    "remote": "origin"
  },
  "github": {
    "release": false,
    "repository": "your-org/your-firmware",
    "token_env": "GITHUB_TOKEN",
    "release_name": "",
    "release_notes_path": "",
    "draft": false,
    "prerelease": false,
    "generate_notes": true
  }
}
